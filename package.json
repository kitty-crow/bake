{
  "name": "@kitty-crow/bake",
  "version": "1.0.0",
  "description": "Lower TypeScript into deterministic subsets for Baguette, Croissant and Crust.",
  "license": "MIT",
  "author": {
    "name": "Kitty Crow",
    "url": "https://kittycrow.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kittycrow-kittyx/bake.git"
  },
  "bin": {
    "bake": "src/cli.ts"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bun --bun tsc --noEmit -p tsconfig.json && bun --bun tsc --noEmit -p tsconfig.test.json",
    "test": "bun test test/bake.test.ts",
    "guards": "bash scripts/guards.sh",
    "build": "bun run guards && bun run check"
  },
  "dependencies": {
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@kitty-crow/code-guards": "git+https://github.com/kitty-crow/code-guards.git#d1ce06c6b4a71e5f94ca97ba4b0f6780408aa3f6"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
